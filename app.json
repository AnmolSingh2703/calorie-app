{
  "expo": {
    "name": "calorie-app",
    "slug": "calorie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to snap photos of your meals and scan nutrition labels.",
        "NSPhotoLibraryUsageDescription": "This app needs gallery access to upload screenshots of nutritional charts.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to log your meals via voice commands.",
        "NSMicrophoneUsageDescription": "This app needs microphone access to record your vocal food logs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NutriSight to use the camera to scan food and labels."
        }
      ]
      // ,
      // [
      //   "expo-speech-recognition",
      //   {
      //     "microphonePermission": "Allow NutriSight to listen to your voice logs."
      //   }
      // ]
    ]
  }
}
//as